APP_NAME=Shopcart
APP_ENV=production
APP_KEY=base64:yourGeneratedAppKeyHere
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://your-ec2-public-ip-or-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION — AWS RDS MariaDB / MySQL
# -------------------------------------------------------------------------
# Ganti dengan Endpoint RDS Anda dari AWS Console > RDS > Databases
DB_CONNECTION=mariadb
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=shopcart
DB_USERNAME=shopcart_user
DB_PASSWORD=your_rds_secure_password

# Untuk RDS dengan SSL (dianjurkan di production):
# MYSQL_ATTR_SSL_CA=/var/www/shopcart/rds-ca-bundle.pem

# -------------------------------------------------------------------------
# SESSION & CACHE
# -------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file

# =========================================================================
# SQL INJECTION DEMONSTRATION MODE CONFIGURATION
# =========================================================================
# Set to 'true' to demonstrate intentionally vulnerable raw SQL queries.
# Set to 'false' to switch to secure parameterized queries / Eloquent.
DEMO_SQLI_MODE=true
