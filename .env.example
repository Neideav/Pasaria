APP_NAME="PASARIA"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://pasaria.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Database (MariaDB / MySQL on AWS RDS)
DB_CONNECTION=mariadb
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=pasaria
DB_USERNAME=pasaria_user
DB_PASSWORD=your_secure_db_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem
DB_SSL_VERIFY_CERT=true

# Sessions & Sanctum SPA Authentication
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pasaria.id,localhost:3000

# Cache & Queues
CACHE_STORE=database
QUEUE_CONNECTION=database

# Filesystem & Object Storage (S3 / R2 / MinIO)
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=pasaria-media
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail Notifications
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@pasaria.id"
MAIL_FROM_NAME="PASARIA Marketplace"

# Security & Educational Flag
DEMO_SQLI_MODE=false