APP_NAME=Shopcart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://3.0.209.239

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =========================================================================
# DATABASE — AWS RDS MariaDB / MySQL
# =========================================================================
DB_CONNECTION=mariadb
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=shopcart
DB_USERNAME=admin
DB_PASSWORD=your_rds_password

# -------------------------------------------------------------------------
# SSL untuk AWS RDS
# -------------------------------------------------------------------------
# OPSI A — Pakai SSL certificate (DIANJURKAN):
#   1. Download: wget https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -O /var/www/shopcart/rds-ca-bundle.pem
#   2. Uncomment baris ini:
# MYSQL_ATTR_SSL_CA=/var/www/shopcart/rds-ca-bundle.pem
#
# OPSI B — Nonaktifkan SSL verification (CEPAT, untuk testing awal):
#   Uncomment baris ini:
# DB_SSL_VERIFY=false
#
# OPSI C — RDS di VPC yang sama (tidak perlu SSL eksternal):
#   Biarkan semua baris SSL di-comment (default, tidak pakai SSL)

# =========================================================================
# SESSION & CACHE
# =========================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file

# =========================================================================
# SQL INJECTION DEMONSTRATION MODE
# =========================================================================
DEMO_SQLI_MODE=true
