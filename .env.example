APP_NAME=Shopcart
APP_ENV=local
APP_KEY=base64:yourGeneratedAppKeyHere
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------------
# Default connection for AWS deployment: 'mariadb' (or 'sqlite' for local file)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopcart
DB_USERNAME=shopcart_user
DB_PASSWORD=shopcart_password_123

# Contoh untuk AWS RDS MariaDB:
# DB_HOST=shopcart-db.xxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=3306
# DB_DATABASE=shopcart
# DB_USERNAME=admin
# DB_PASSWORD=your_rds_secure_password

# Opsi alternatif jika ingin tetap menggunakan SQLite lokal:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

# =========================================================================
# SQL INJECTION DEMONSTRATION MODE CONFIGURATION
# =========================================================================
# Set to 'true' to demonstrate intentionally vulnerable raw SQL queries.
# Set to 'false' to switch to secure parameterized queries / Eloquent.
# This setting only affects the backend. The frontend remains 100% identical.
DEMO_SQLI_MODE=true
