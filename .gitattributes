# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts always LF (Linux servers)
*.sh text eol=lf

# PHP files LF
*.php text eol=lf

# Config files LF
*.conf text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows batch (if any) CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
